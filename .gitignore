# whitelist: solo codice, prompt e documentazione. Niente registrazioni, clip, suoni/musica (licenze CapCut), segreti, stato.
/*
!/.gitignore
!/*.py
!/*.sh
!/README.md
!/LICENSE
!/config.example.json
!/prompt/
!/launchd/
!/docs/
!/remotion/
/remotion/*
!/remotion/src/
!/remotion/render.mjs
!/remotion/presets.json
!/laboratorio/
/laboratorio/*
!/laboratorio/monta.py
!/laboratorio/libreria.json
!/laboratorio/catalogo.md
!/laboratorio/remotion/
/laboratorio/remotion/*
!/laboratorio/remotion/src/
!/laboratorio/remotion/render*.mjs
!/laboratorio/remotion/presets.json
!/laboratorio/strumenti/
/laboratorio/strumenti/__pycache__/
/laboratorio/strumenti/volti
__pycache__/
*.pyc
.DS_Store
