# whitelist: solo codice, prompt e documentazione. Niente registrazioni, clip, suoni/musica (licenze CapCut), segreti, stato.
/*
!/.gitignore
!/*.py
!/*.sh
!/README.md
!/LICENSE
!/config.example.json
!/prompt/
!/launchd/
!/docs/
!/remotion/
/remotion/*
!/remotion/src/
!/remotion/render.mjs
!/remotion/presets.json
!/laboratorio/
/laboratorio/*
!/laboratorio/monta.py
!/laboratorio/libreria.json
!/laboratorio/catalogo.md
!/laboratorio/remotion/
/laboratorio/remotion/*
!/laboratorio/remotion/src/
!/laboratorio/remotion/render*.mjs
!/laboratorio/remotion/presets.json
!/laboratorio/strumenti/
/laboratorio/strumenti/__pycache__/
/laboratorio/strumenti/volti
__pycache__/
*.pyc
.DS_Store
# stili e speedy-ultra (20/11, prima di cancellare la copia locale): solo codice, prompt, regole e metadati
!/stili/
!/schede/
!/laboratorio/ultra/
/laboratorio/ultra/giri/
/laboratorio/ultra/dati/*/*
!/laboratorio/ultra/dati/*/fonte.json
/laboratorio/ultra/dati/_sottotitoli/
/laboratorio/ultra/editore/lavoro/
/laboratorio/ultra/editore/remotion/*
!/laboratorio/ultra/editore/remotion/src/
!/laboratorio/ultra/editore/remotion/*.mjs
!/laboratorio/ultra/editore/remotion/*.json
/laboratorio/ultra/editore/remotion/package-lock.json
*.log
/laboratorio/ultra/editore/_ombra/musica
/laboratorio/ultra/editore/_ombra/suoni
/laboratorio/strumenti/testi
